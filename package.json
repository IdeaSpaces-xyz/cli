{
  "name": "@ideaspaces/cli",
  "version": "0.2.23",
  "type": "module",
  "description": "IdeaSpaces CLI — capture durable agent knowledge from the command line",
  "keywords": [
    "ideaspaces",
    "knowledge",
    "cli",
    "markdown",
    "notes",
    "git",
    "local-first",
    "agent"
  ],
  "bin": {
    "ideaspaces": "bundle/ideaspaces.js"
  },
  "files": [
    "bundle"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['bundle', 'dist']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && npm run bundle",
    "bundle": "node build.mjs",
    "check:package": "npm run build && node scripts/check-package.mjs && node scripts/check-bundle.mjs",
    "check:consumers": "node scripts/check-consumers.mjs",
    "api:inventory": "node scripts/api-calls.mjs",
    "check:api": "node scripts/check-api-parity.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@ideaspaces/protocol": "github:IdeaSpaces-xyz/ideaspace-protocol#b490e20c6a438c353f7bbf73169cb47052aaf46a",
    "@ideaspaces/sdk": "github:IdeaSpaces-xyz/sdk#96f51f660eb05dc6eb4a222b670efb066994c93b",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IdeaSpaces-xyz/cli.git"
  },
  "homepage": "https://ideaspaces.xyz/developers",
  "bugs": {
    "url": "https://github.com/IdeaSpaces-xyz/cli/issues"
  }
}
